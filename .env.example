# Server Configuration
PORT=5000

# Shared MongoDB Connection URI (reused across practicals)
# Replace with your MongoDB Atlas cluster URI or local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tanvi_projects?retryWrites=true&w=majority

# Unified Database Name
DB_NAME=tanvi_projects

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Notification Delay in Milliseconds for Event-Driven Processing (Practical 10)
NOTIFICATION_DELAY_MS=2000

# Gemini AI API Configuration (Practical 13)
# BACKEND-ONLY: Never expose this key in frontend code, client network requests, or Git
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Docker Compose Environment Notes (Practical 11)
# ==========================================
# When running with Docker Compose (`docker compose up --build`):
# - JWT_SECRET and NOTIFICATION_DELAY_MS are read by docker-compose from your local .env (or fallbacks apply).
# - MONGO_URI is defined directly inside docker-compose.yml as 'mongodb://mongodb:27017/tanvi_projects'
#   (using the internal Docker service name 'mongodb', NOT localhost).
# - Local MongoDB Atlas / local development settings remain unchanged when running without Docker.
# - Do NOT copy or commit your real .env file into images or Git.
