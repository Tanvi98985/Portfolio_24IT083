# Server Configuration
PORT=5000

# Shared MongoDB Connection URI (reused across practicals)
# Replace with your MongoDB Atlas cluster URI or local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tanvi_projects?retryWrites=true&w=majority

# Unified Database Name
DB_NAME=tanvi_projects

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
