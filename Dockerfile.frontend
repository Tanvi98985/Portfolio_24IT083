# ==========================================
# Stage 1: Build the React + Vite frontend
# ==========================================
FROM node:20-alpine AS build

WORKDIR /app

# Copy package manifests and install all dependencies (including devDependencies for Vite)
COPY package*.json ./
RUN npm ci

# Copy application source files
COPY . .

# Build-time argument for backend API URL
# Browser runs on host, so localhost:5000 is used to reach the backend
ARG VITE_API_BASE_URL=http://localhost:5000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build production bundle into /app/dist
RUN npm run build

# ==========================================
# Stage 2: Serve production bundle with Nginx
# ==========================================
FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built frontend assets from Stage 1
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration supporting SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose Vite/Nginx frontend port
EXPOSE 5173

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
