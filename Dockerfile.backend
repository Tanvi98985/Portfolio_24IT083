# Use lightweight Node.js 20 Alpine Linux base image
# Node 20+ is required by Mongoose 9 and Dotenv 17
FROM node:20-alpine

# Set working directory inside the container
WORKDIR /app

# Copy dependency manifests first to leverage Docker layer caching
COPY package*.json ./

# Install only production dependencies inside the container
# Never copy host node_modules into the container
RUN npm ci --omit=dev

# Copy backend application source code
COPY server ./server

# Expose backend port
ENV PORT=5000
EXPOSE 5000

# Start backend Node.js Express server
CMD ["node", "server/server.js"]
